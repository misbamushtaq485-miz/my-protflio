---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  path?: string;
}

const {
  title,
  description,
  path = "/",
} = Astro.props;

const canonicalURL = Astro.site ? new URL(path, Astro.site) : undefined;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='28' fill='%236366f1'/><text x='50%' y='55%' dominant-baseline='central' text-anchor='middle' fill='%23ffffff' font-size='50' font-family='sans-serif' font-weight='800'>M</text></svg>" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <title>{title}</title>
    
    <!-- Astro View Transitions -->
    <ClientRouter />

    <!-- Anti-FOUC Theme Script -->
    <script is:inline>
      function applyTheme() {
        const storedTheme = localStorage.getItem("portfolio-theme") || "dark";
        let resolvedTheme = storedTheme;
        if (storedTheme === "system") {
          resolvedTheme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.dataset.theme = resolvedTheme;
        document.documentElement.classList.toggle("dark", resolvedTheme === "dark");
      }
      applyTheme();
      document.addEventListener("astro:after-swap", applyTheme);
    </script>
  </head>
  <body class="min-h-screen bg-[#fafafa] dark:bg-[#090d16] text-zinc-900 dark:text-zinc-100 selection:bg-indigo-500/20 selection:text-indigo-600 dark:selection:text-indigo-300 font-sans antialiased relative">
    <a class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-indigo-600 focus:text-white focus:rounded-lg focus:shadow-xl focus:outline-none" href="#main-content">
      Skip to content
    </a>
    
    <!-- Ambient background glows -->
    <div class="fixed inset-0 pointer-events-none -z-10 overflow-hidden">
      <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-gradient-to-b from-indigo-500/10 via-sky-500/5 to-transparent blur-3xl rounded-full dark:from-indigo-600/15 dark:via-sky-500/10"></div>
      <div class="absolute top-[40%] -right-40 w-[400px] h-[400px] bg-indigo-500/5 dark:bg-indigo-600/10 blur-[100px] rounded-full"></div>
      <div class="absolute bottom-20 -left-40 w-[400px] h-[400px] bg-sky-500/5 dark:bg-sky-500/10 blur-[100px] rounded-full"></div>
    </div>

    <slot />
  </body>
</html>
