---
import { Image } from "astro:assets";
import {
  ArrowRight,
  ArrowUpRight,
  Check,
  CircleCheck,
  Copy,
  ExternalLink,
  FileText,
  GraduationCap,
  Mail,
  MapPin,
  Send,
  Sparkles,
} from "@lucide/astro";

import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import Reveal from "../components/Reveal.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Carousel from "../components/Carousel.astro";
import Marquee from "../components/Marquee.astro";
import LinkedInIcon from "../components/LinkedInIcon.astro";

import {
  learning,
  marqueeItems,
  milestones,
  principles,
  profile,
  projects,
  rotatingWords,
  skillCategories,
  skills,
  stats,
} from "../data/portfolio";

import profileImage from "../../profile1.png";
import registrationImage from "../../registration.png";
import resumeImage from "../../resume.png";

const projectImages: Record<string, ImageMetadata | null> = {
  registration: registrationImage,
  resume: resumeImage,
  portfolio: null,
};

const rotatorJson = JSON.stringify(rotatingWords);
---

<BaseLayout
  title={`${profile.name} | IT Student & Frontend Web Developer`}
  description={`Portfolio of ${profile.name}, an Information Technology student and frontend developer in Srinagar, Kashmir. Modern, accessible, high-performance web experiences.`}
>
  <div id="top"></div>
  <Header />

  <main id="main-content" class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- ================= HERO ================= -->
    <section
      class="relative pt-10 sm:pt-16 pb-12 sm:pb-20"
      aria-labelledby="hero-title"
    >
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-center">
        <!-- Copy -->
        <div class="lg:col-span-7 space-y-7">
          <Reveal variant="down">
            <span
              class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-semibold text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 border border-emerald-500/20"
            >
              <span class="relative flex w-2.5 h-2.5">
                <span class="absolute inset-0 rounded-full bg-emerald-400 animate-ring"></span>
                <span class="relative w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
              </span>
              Available for internships & collaborations
            </span>
          </Reveal>

          <div class="space-y-5">
            <Reveal variant="up" delay={60}>
              <p class="eyebrow">
                <Sparkles class="w-3.5 h-3.5" />
                {profile.role}
              </p>
            </Reveal>

            <Reveal variant="up" delay={120}>
              <h1
                id="hero-title"
                class="text-[2.6rem] sm:text-6xl lg:text-7xl font-extrabold leading-[1.02] tracking-tight"
              >
                Building
                <span class="text-gradient rotator" data-rotate={rotatorJson}>
                  accessible
                </span>
                <br class="hidden sm:inline" />
                web experiences.
              </h1>
            </Reveal>

            <Reveal variant="up" delay={180}>
              <p class="text-base sm:text-lg soft leading-relaxed max-w-xl">
                Hi, I'm <strong class="font-semibold" style="color:var(--text)"
                  >{profile.name}</strong
                >. A 5th-semester IT student in {profile.locationShort}.
                {profile.tagline}
              </p>
            </Reveal>
          </div>

          <Reveal variant="up" delay={240}>
            <div class="flex flex-wrap items-center gap-3">
              <a href="#work" class="btn btn-primary group">
                Explore my work
                <ArrowRight
                  class="w-4 h-4 transition-transform group-hover:translate-x-1"
                />
              </a>

              <a href="/resume/" class="btn btn-ghost group">
                <FileText class="w-4 h-4 muted" />
                View resume
                <ArrowUpRight
                  class="w-4 h-4 opacity-60 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                />
              </a>

              <button type="button" class="btn btn-quiet" data-copy={profile.email}>
                <span data-copy-idle><Copy class="w-4 h-4 text-brand" /></span>
                <span data-copy-done class="hidden"
                  ><Check class="w-4 h-4 text-emerald-500" /></span
                >
                <span data-copy-label>Copy email</span>
              </button>
            </div>
          </Reveal>

          <!-- Stats -->
          <Reveal variant="up" delay={300}>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-x-4 gap-y-6 pt-7 border-t">
              {
                stats.map((stat) => (
                  <div class="space-y-0.5">
                    <p class="font-display text-3xl font-extrabold tabular-nums">
                      <span
                        data-count-to={String(stat.value)}
                        data-count-suffix={stat.suffix}
                        data-count-pad={stat.pad ? "true" : "false"}
                      >
                        0
                      </span>
                    </p>
                    <p class="text-xs font-semibold">{stat.label}</p>
                    <p class="text-[11px] muted">{stat.hint}</p>
                  </div>
                ))
              }
            </div>
          </Reveal>
        </div>

        <!-- Portrait -->
        <div class="lg:col-span-5">
          <Reveal variant="scale" delay={160} class="relative mx-auto max-w-sm">
            <div
              class="absolute -inset-6 rounded-[2.5rem] blur-2xl -z-10 animate-float"
              style="background:radial-gradient(60% 60% at 50% 30%,var(--glow-1),transparent 70%),radial-gradient(50% 50% at 80% 80%,var(--glow-3),transparent 70%)"
            >
            </div>

            <div
              class="card edge-glow rounded-[2rem] p-3 tilt"
              data-tilt="6"
            >
              <div class="relative overflow-hidden rounded-[1.5rem] aspect-[4/5]">
                <Image
                  src={profileImage}
                  alt={`${profile.name} portrait`}
                  widths={[360, 560, 760]}
                  sizes="(max-width: 640px) 90vw, 380px"
                  format="webp"
                  quality={82}
                  loading="eager"
                  class="w-full h-full object-cover object-center scale-[1.01]"
                  transition:name="profile-portrait"
                />
                <div
                  class="absolute inset-0 pointer-events-none"
                  style="background:linear-gradient(to top,rgba(0,0,0,0.72),transparent 55%)"
                >
                </div>

                <div
                  class="absolute bottom-3 left-3 right-3 p-3 rounded-2xl flex items-center justify-between text-white border border-white/15"
                  style="background:rgba(10,10,20,0.4);backdrop-filter:blur(14px)"
                >
                  <div>
                    <p class="text-xs font-bold">{profile.name}</p>
                    <p class="text-[10px] text-white/70">
                      {profile.schoolShort} · {profile.semester}
                    </p>
                  </div>
                  <span
                    class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-emerald-500/90 text-[10px] font-semibold"
                  >
                    <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
                    Active
                  </span>
                </div>
              </div>

              <div class="mt-3 flex items-center justify-between px-1.5 pb-1 text-[11px] font-medium muted">
                <span class="inline-flex items-center gap-1.5">
                  <MapPin class="w-3.5 h-3.5 text-brand" />
                  {profile.locationShort}
                </span>
                <span class="inline-flex items-center gap-1.5">
                  <GraduationCap class="w-3.5 h-3.5" style="color:var(--accent)" />
                  Diploma in IT
                </span>
              </div>
            </div>

            <!-- Floating credential chips -->
            <div
              class="hidden sm:flex absolute -left-6 top-1/4 card rounded-2xl px-3 py-2 items-center gap-2 animate-float"
              style="animation-delay:-2s"
            >
              <span class="w-7 h-7 rounded-lg grid place-items-center tint-brand">
                <Icon name="Code" class="w-3.5 h-3.5" />
              </span>
              <span class="text-[11px] font-semibold leading-tight">
                Frontend<br /><span class="muted font-normal">focused</span>
              </span>
            </div>

            <div
              class="hidden sm:flex absolute -right-4 bottom-1/4 card rounded-2xl px-3 py-2 items-center gap-2 animate-float"
              style="animation-delay:-4s"
            >
              <span class="w-7 h-7 rounded-lg grid place-items-center tint-accent">
                <Icon name="Zap" class="w-3.5 h-3.5" />
              </span>
              <span class="text-[11px] font-semibold leading-tight">
                Static-first<br /><span class="muted font-normal">performance</span>
              </span>
            </div>
          </Reveal>
        </div>
      </div>

      <!-- Scroll cue -->
      <div class="hidden lg:flex justify-center pt-14">
        <a
          href="#about"
          class="flex flex-col items-center gap-2 muted hover:text-brand transition-colors"
          aria-label="Scroll to about section"
        >
          <span class="text-[10px] font-bold uppercase tracking-[0.2em]">Scroll</span>
          <span class="scroll-cue"><i></i></span>
        </a>
      </div>
    </section>

    <!-- ================= MARQUEE ================= -->
    <section class="py-6 sm:py-10" aria-label="Technologies I work with">
      <Reveal variant="blur" class="space-y-3">
        <Marquee items={marqueeItems} duration={38} />
        <Marquee items={[...marqueeItems].reverse()} duration={46} reverse />
      </Reveal>
    </section>

    <!-- ================= ABOUT ================= -->
    <section id="about" class="scroll-mt-28 pt-16 sm:pt-24 space-y-12" aria-labelledby="about-title">
      <SectionHeading
        id="about-title"
        eyebrow="Background & mindset"
        eyebrowIcon="Compass"
        title="I learn best by"
        accent="building real software."
        note="Bridging technical concepts and visual clarity to craft interfaces people can actually use."
      />

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">
        <!-- Story -->
        <Reveal variant="left" class="lg:col-span-7">
          <article class="card card-lift spotlight h-full rounded-3xl p-6 sm:p-9 flex flex-col gap-6">
            <div class="space-y-4">
              <h3 class="font-display text-xl sm:text-2xl font-bold">
                From curiosity to craft
              </h3>
              <p class="soft leading-relaxed">
                I'm in the <strong style="color:var(--text)"
                  >5th semester of the Information Technology Diploma at {profile.school}</strong
                >. My interest in the web started with a simple question: how do a few
                lines of markup turn into something people can use?
              </p>
              <p class="text-sm muted leading-relaxed">
                Rather than just consuming technology, I take it apart. That habit
                turned into a focus on front-end foundations — semantic HTML, adaptive
                layouts with modern CSS and Tailwind, precise JavaScript interactions,
                and Astro for static-first performance.
              </p>
              <p class="text-sm muted leading-relaxed">
                Every concept from class gets rebuilt as something that actually runs in
                a browser. That's how it sticks.
              </p>
            </div>

            <div class="mt-auto grid grid-cols-2 sm:grid-cols-4 gap-3 pt-6 border-t">
              {
                principles.map((p) => (
                  <div class="space-y-1.5">
                    <span class="w-8 h-8 rounded-xl grid place-items-center tint-brand">
                      <Icon name={p.icon} class="w-4 h-4" />
                    </span>
                    <p class="text-xs font-bold leading-tight">{p.title}</p>
                    <p class="text-[11px] muted leading-snug">{p.desc}</p>
                  </div>
                ))
              }
            </div>
          </article>
        </Reveal>

        <!-- Side bento -->
        <div class="lg:col-span-5 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-5">
          <Reveal variant="right" delay={60}>
            <article class="card card-lift spotlight h-full rounded-3xl p-6 flex gap-4">
              <span class="w-11 h-11 shrink-0 rounded-2xl grid place-items-center tint-brand">
                <GraduationCap class="w-5 h-5" />
              </span>
              <div class="space-y-1">
                <h3 class="font-bold">{profile.schoolShort}</h3>
                <p class="text-[11px] font-semibold muted uppercase tracking-wider">
                  Diploma in Information Technology
                </p>
                <p class="text-xs muted leading-relaxed pt-1">
                  5th-semester coursework across computer architecture, networks,
                  databases and software engineering.
                </p>
              </div>
            </article>
          </Reveal>

          <Reveal variant="right" delay={120}>
            <article class="card card-lift spotlight h-full rounded-3xl p-6 flex gap-4">
              <span class="w-11 h-11 shrink-0 rounded-2xl grid place-items-center tint-accent">
                <Icon name="Code" class="w-5 h-5" />
              </span>
              <div class="space-y-1">
                <h3 class="font-bold">Front-end focus</h3>
                <p class="text-[11px] font-semibold muted uppercase tracking-wider">
                  Modern web standards
                </p>
                <p class="text-xs muted leading-relaxed pt-1">
                  Astro, Tailwind CSS v4, ES6+ JavaScript and design systems that scale
                  past the first screen.
                </p>
              </div>
            </article>
          </Reveal>

          <Reveal variant="right" delay={180}>
            <article class="card card-lift spotlight h-full rounded-3xl p-6 space-y-4">
              <div class="flex items-center justify-between">
                <h3 class="font-bold inline-flex items-center gap-2">
                  <CircleCheck class="w-4 h-4 text-emerald-500" />
                  Currently learning
                </h3>
                <span class="chip chip-brand">Live</span>
              </div>
              <div class="space-y-3">
                {
                  learning.slice(0, 3).map((item) => (
                    <div class="space-y-1.5">
                      <div class="flex items-center justify-between text-xs">
                        <span class="font-semibold">{item.title}</span>
                        <span class="muted tabular-nums">{item.progress}%</span>
                      </div>
                      <div class="meter" data-meter={String(item.progress)}>
                        <span></span>
                      </div>
                    </div>
                  ))
                }
              </div>
            </article>
          </Reveal>
        </div>
      </div>
    </section>

    <!-- ================= SKILLS ================= -->
    <section id="skills" class="scroll-mt-28 pt-20 sm:pt-28 space-y-10" aria-labelledby="skills-title">
      <SectionHeading
        id="skills-title"
        eyebrow="Skills & capabilities"
        eyebrowIcon="Code"
        title="A toolkit built"
        accent="foundation-first."
        note="Filter by area — every entry is something I use, not something I've only read about."
      />

      <Reveal variant="up">
        <div
          class="flex flex-wrap gap-2"
          data-filter-group="#skills-grid"
          role="group"
          aria-label="Filter skills by area"
        >
          {
            skillCategories.map((cat) => (
              <button
                type="button"
                class="filter-chip"
                data-filter={cat.id}
                aria-pressed={cat.id === "all" ? "true" : "false"}
              >
                {cat.label}
              </button>
            ))
          }
        </div>
      </Reveal>

      <div id="skills-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {
          skills.map((skill, i) => (
            <article
              class="card card-lift spotlight edge-glow rounded-3xl p-6 flex flex-col gap-4"
              data-cat={skill.cat}
              data-reveal="up"
              data-reveal-delay={String(Math.min(i, 6) * 60)}
            >
              <div class="flex items-start justify-between gap-3">
                <span class="w-11 h-11 rounded-2xl grid place-items-center tint-brand">
                  <Icon name={skill.icon} class="w-5 h-5" />
                </span>
                <span class="chip">{skill.tag}</span>
              </div>

              <div class="space-y-1.5">
                <h3 class="font-display font-bold text-lg leading-tight">
                  {skill.name}
                </h3>
                <p class="text-sm muted leading-relaxed">{skill.desc}</p>
              </div>

              <div class="mt-auto space-y-2 pt-3 border-t">
                <div class="flex items-center justify-between text-[11px] font-semibold">
                  <span class="muted uppercase tracking-wider">Confidence</span>
                  <span class="text-brand tabular-nums">{skill.level}%</span>
                </div>
                <div class="meter" data-meter={String(skill.level)}>
                  <span></span>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ================= WORK ================= -->
    <section id="work" class="scroll-mt-28 pt-20 sm:pt-28 space-y-10" aria-labelledby="work-title">
      <SectionHeading
        id="work-title"
        eyebrow="Portfolio showcase"
        eyebrowIcon="Layers"
        title="Things I've built,"
        accent="end to end."
        note="Drag, swipe or use the arrows — each project documents a step from structure to interactivity."
      />

      <Reveal variant="up">
        <Carousel label="Projects" variant="peek" autoplay={7000} loop>
          {
            projects.map((project) => {
              const img = projectImages[project.slug];
              return (
                <article class="carousel__slide">
                  <div class="card card-lift spotlight edge-glow rounded-3xl overflow-hidden h-full flex flex-col">
                    <a
                      href={project.href}
                      class="relative block aspect-[16/10] overflow-hidden group"
                      aria-label={`${project.title} — ${project.cta}`}
                    >
                      {img ? (
                        <Image
                          src={img}
                          alt={`${project.title} preview`}
                          widths={[480, 760, 1100]}
                          sizes="(max-width: 1024px) 90vw, 560px"
                          format="webp"
                          quality={82}
                          class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-[1.06]"
                        />
                      ) : (
                        <div
                          class="w-full h-full grid place-items-center"
                          style="background:linear-gradient(135deg,color-mix(in oklab,var(--brand) 22%,transparent),color-mix(in oklab,var(--accent) 18%,transparent))"
                        >
                          <div class="text-center space-y-2 px-6">
                            <p class="font-mono text-[11px] tracking-[0.3em] uppercase muted">
                              design system
                            </p>
                            <p class="font-display text-2xl sm:text-3xl font-extrabold">
                              tokens · motion
                              <br />
                              carousels · timeline
                            </p>
                          </div>
                        </div>
                      )}

                      <div
                        class="absolute inset-0 pointer-events-none"
                        style="background:linear-gradient(to top,rgba(0,0,0,0.55),transparent 60%)"
                      ></div>

                      <span class="absolute top-4 left-4 chip chip-brand backdrop-blur-md">
                        {project.featured ? "Featured project" : `Project ${project.number}`}
                      </span>

                      <span class="absolute bottom-4 right-4 w-10 h-10 rounded-full grid place-items-center card transition-transform duration-300 group-hover:scale-110">
                        <ArrowUpRight class="w-4 h-4" />
                      </span>
                    </a>

                    <div class="p-6 sm:p-7 flex flex-col gap-5 flex-1">
                      <div class="space-y-2">
                        <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-brand">
                          {project.number} · {project.kind}
                        </p>
                        <h3 class="font-display text-xl sm:text-2xl font-bold leading-tight">
                          {project.title}
                        </h3>
                        <p class="text-sm muted leading-relaxed">{project.summary}</p>
                      </div>

                      <ul class="space-y-1.5">
                        {project.highlights.map((h) => (
                          <li class="flex items-start gap-2 text-xs soft">
                            <CircleCheck class="w-3.5 h-3.5 mt-0.5 shrink-0 text-brand" />
                            <span>{h}</span>
                          </li>
                        ))}
                      </ul>

                      <div class="flex flex-wrap gap-1.5">
                        {project.stack.map((tech) => (
                          <span class="chip">{tech}</span>
                        ))}
                      </div>

                      <div class="mt-auto pt-2">
                        <a href={project.href} class="btn btn-primary btn-sm group">
                          {project.cta}
                          {project.slug === "registration" ? (
                            <ExternalLink class="w-3.5 h-3.5" />
                          ) : (
                            <ArrowRight class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" />
                          )}
                        </a>
                      </div>
                    </div>
                  </div>
                </article>
              );
            })
          }
        </Carousel>
      </Reveal>
    </section>

    <!-- ================= JOURNEY / TIMELINE ================= -->
    <section id="journey" class="scroll-mt-28 pt-20 sm:pt-28 space-y-14" aria-labelledby="journey-title">
      <SectionHeading
        id="journey-title"
        eyebrow="Milestones"
        eyebrowIcon="Calendar"
        title="Where I am and"
        accent="where I'm headed."
        note="A steady trajectory from computer fundamentals toward full-stack engineering."
      />

      <div class="timeline" data-timeline>
        <div class="timeline__rail" aria-hidden="true"><span></span></div>

        <ol class="space-y-10 lg:space-y-16">
        {
          milestones.map((item) => (
            <li class="timeline__item" data-tl-item>
              <div class="timeline__node" aria-hidden="true"><i></i></div>

              <div class="timeline__card card card-lift spotlight rounded-3xl p-6 sm:p-7 space-y-3" data-reveal="up">
                <div class="tl-row flex flex-wrap items-center gap-2">
                  <span class="chip chip-brand">
                    <Icon name={item.icon} class="w-3 h-3" />
                    {item.phase}
                  </span>
                  <span class="text-[11px] font-semibold muted">{item.period}</span>
                  {item.current && (
                    <span class="chip text-emerald-600 dark:text-emerald-400">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                      Now
                    </span>
                  )}
                </div>

                <div class="space-y-1">
                  <h3 class="font-display text-lg sm:text-xl font-bold">{item.title}</h3>
                  <p class="text-xs font-semibold muted">{item.place}</p>
                </div>

                <p class="text-sm muted leading-relaxed">{item.desc}</p>

                <div class="tl-row flex flex-wrap gap-1.5 pt-1">
                  {item.tags.map((tag) => (
                    <span class="chip">{tag}</span>
                  ))}
                </div>
              </div>
            </li>
          ))
        }
        </ol>
      </div>
    </section>

    <!-- ================= LEARNING CAROUSEL ================= -->
    <section class="pt-20 sm:pt-28 space-y-10" aria-labelledby="learning-title">
      <SectionHeading
        id="learning-title"
        eyebrow="On the workbench"
        eyebrowIcon="FlaskConical"
        title="What I'm learning"
        accent="right now."
        note="An honest snapshot — some of this is coursework, some is curiosity."
      />

      <Reveal variant="up">
        <Carousel label="Current learning topics" variant="trio" autoplay={5000} loop counter={false}>
          {
            learning.map((item) => (
              <article class="carousel__slide">
                <div class="card card-lift spotlight rounded-3xl p-6 h-full flex flex-col gap-4">
                  <div class="flex items-center justify-between">
                    <span class="w-11 h-11 rounded-2xl grid place-items-center tint-brand">
                      <Icon name={item.icon} class="w-5 h-5" />
                    </span>
                    <span class="chip">{item.status}</span>
                  </div>

                  <div class="space-y-1.5">
                    <h3 class="font-display font-bold text-lg">{item.title}</h3>
                    <p class="text-sm muted leading-relaxed">{item.desc}</p>
                  </div>

                  <div class="mt-auto space-y-2 pt-3 border-t">
                    <div class="flex items-center justify-between text-[11px] font-semibold">
                      <span class="muted uppercase tracking-wider">Progress</span>
                      <span class="text-brand tabular-nums">{item.progress}%</span>
                    </div>
                    <div class="meter" data-meter={String(item.progress)}><span></span></div>
                  </div>
                </div>
              </article>
            ))
          }
        </Carousel>
      </Reveal>
    </section>

    <!-- ================= CONTACT ================= -->
    <section id="contact" class="scroll-mt-28 pt-20 sm:pt-28" aria-labelledby="contact-title">
      <Reveal variant="up">
        <div class="card rounded-[2rem] p-6 sm:p-10 lg:p-14 relative overflow-hidden">
          <div
            class="absolute -top-32 -right-32 w-96 h-96 rounded-full blur-3xl pointer-events-none"
            style="background:radial-gradient(closest-side,var(--glow-1),transparent 70%)"
          >
          </div>

          <div class="relative grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14">
            <!-- Info -->
            <div class="lg:col-span-5 space-y-6">
              <span class="eyebrow">
                <Send class="w-3.5 h-3.5" />
                Let's connect
              </span>
              <h2
                id="contact-title"
                class="text-3xl sm:text-4xl font-extrabold leading-[1.1]"
              >
                Have an opportunity
                <br class="hidden sm:inline" />
                or project? <span class="text-gradient">Let's talk.</span>
              </h2>
              <p class="text-sm sm:text-base muted leading-relaxed">
                I'm open to internships, junior developer roles and open-source
                collaborations. Reach out directly, or send a note with the form —
                it opens a pre-filled draft in your own mail client.
              </p>

              <div class="space-y-3 pt-5 border-t">
                <a href={`mailto:${profile.email}`} class="contact-row group">
                  <span class="w-10 h-10 rounded-2xl grid place-items-center tint-brand shrink-0">
                    <Mail class="w-4 h-4" />
                  </span>
                  <span>
                    <span class="text-[11px] muted block">Email</span>
                    <span class="text-sm font-semibold">{profile.email}</span>
                  </span>
                </a>

                <a
                  href={profile.linkedin}
                  target="_blank"
                  rel="noreferrer"
                  class="contact-row group"
                >
                  <span class="w-10 h-10 rounded-2xl grid place-items-center tint-accent shrink-0">
                    <LinkedInIcon class="w-4 h-4" />
                  </span>
                  <span>
                    <span class="text-[11px] muted block">LinkedIn</span>
                    <span class="text-sm font-semibold inline-flex items-center gap-1">
                      {profile.linkedinHandle}
                      <ExternalLink class="w-3 h-3 opacity-60" />
                    </span>
                  </span>
                </a>

                <div class="contact-row">
                  <span
                    class="w-10 h-10 rounded-2xl grid place-items-center shrink-0 text-emerald-600 dark:text-emerald-400 bg-emerald-500/10"
                  >
                    <MapPin class="w-4 h-4" />
                  </span>
                  <span>
                    <span class="text-[11px] muted block">Location</span>
                    <span class="text-sm font-semibold">{profile.location}</span>
                  </span>
                </div>
              </div>
            </div>

            <!-- Form -->
            <div class="lg:col-span-7">
              <form id="contact-form" class="space-y-5">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label class="field-label" for="contact-name">Your name *</label>
                    <input
                      class="field"
                      id="contact-name"
                      name="name"
                      type="text"
                      required
                      autocomplete="name"
                      placeholder="e.g. Jane Doe"
                    />
                  </div>
                  <div>
                    <label class="field-label" for="contact-email">Your email *</label>
                    <input
                      class="field"
                      id="contact-email"
                      name="email"
                      type="email"
                      required
                      autocomplete="email"
                      placeholder="jane@example.com"
                    />
                  </div>
                </div>

                <div>
                  <label class="field-label" for="contact-subject">Subject *</label>
                  <input
                    class="field"
                    id="contact-subject"
                    name="subject"
                    type="text"
                    required
                    placeholder="Internship opportunity / project inquiry"
                  />
                  <div class="flex flex-wrap gap-1.5 pt-2.5">
                    {
                      [
                        "Internship opportunity",
                        "Freelance project",
                        "Collaboration",
                        "Just saying hi",
                      ].map((preset) => (
                        <button type="button" class="chip subject-preset" data-preset={preset}>
                          {preset}
                        </button>
                      ))
                    }
                  </div>
                </div>

                <div>
                  <label class="field-label" for="contact-message">Message *</label>
                  <textarea
                    class="field resize-none"
                    id="contact-message"
                    name="message"
                    rows="4"
                    required
                    placeholder="Share a little about what you'd like to work on..."></textarea>
                </div>

                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                  <button type="submit" class="btn btn-primary group">
                    Launch email draft
                    <Send
                      class="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                    />
                  </button>
                  <p class="text-xs muted">Opens in your preferred mail client.</p>
                </div>

                <div
                  id="contact-feedback"
                  class="hidden p-4 rounded-2xl text-sm text-emerald-700 dark:text-emerald-300 bg-emerald-500/10 border border-emerald-500/25"
                  role="status"
                  aria-live="polite"
                >
                  Draft prepared — opening your mail client...
                </div>
              </form>
            </div>
          </div>
        </div>
      </Reveal>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .contact-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.35rem 0;
    border-radius: 0.9rem;
    transition: transform 0.25s ease;
  }
  a.contact-row:hover {
    transform: translateX(3px);
  }
  .subject-preset {
    cursor: pointer;
  }
  .subject-preset:hover {
    background: color-mix(in oklab, var(--brand) 14%, transparent);
    color: var(--brand);
  }
</style>

<script>
  function setupContact() {
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    if (!form || form.hasAttribute("data-bound")) return;
    form.setAttribute("data-bound", "true");

    const feedback = document.getElementById("contact-feedback");
    const subject = document.getElementById("contact-subject") as HTMLInputElement | null;

    document.querySelectorAll<HTMLElement>(".subject-preset").forEach((chip) =>
      chip.addEventListener("click", () => {
        if (!subject) return;
        subject.value = chip.dataset.preset || "";
        subject.focus();
      })
    );

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const data = new FormData(form);
      const name = String(data.get("name") || "");
      const email = String(data.get("email") || "");
      const subjectLine = String(data.get("subject") || `Portfolio message from ${name}`);
      const message = String(data.get("message") || "");

      const body = encodeURIComponent(
        `Hi Misba,\n\n${message}\n\n---\nFrom: ${name}\nEmail: ${email}`
      );

      feedback?.classList.remove("hidden");
      window.location.href = `mailto:misbamushtaq485@gmail.com?subject=${encodeURIComponent(
        subjectLine
      )}&body=${body}`;
    });
  }

  document.addEventListener("astro:page-load", setupContact);
  if (document.readyState !== "loading") setupContact();
</script>
