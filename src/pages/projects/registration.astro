---
import {
  ArrowLeft,
  ArrowRight,
  BookOpen,
  CircleCheck,
  GraduationCap,
  Mail,
  RotateCcw,
  ShieldCheck,
  Sparkles,
  User,
} from "@lucide/astro";

import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Reveal from "../../components/Reveal.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import Carousel from "../../components/Carousel.astro";
import Icon from "../../components/Icon.astro";

const facts = [
  { label: "Role", value: "Front-end design & logic" },
  { label: "Stack", value: "HTML5 · Tailwind · JS DOM" },
  { label: "Focus", value: "Accessibility & live feedback" },
  { label: "Year", value: "2025" },
];

const takeaways = [
  {
    icon: "Code",
    title: "Semantic form architecture",
    desc: "Descriptive labels, grouped fieldsets, required attributes and autocomplete tokens measurably improve the screen-reader experience.",
  },
  {
    icon: "Zap",
    title: "Reactive client-side DOM",
    desc: "Binding input and change events to one centralised update function keeps UI state honest without reaching for a framework.",
  },
  {
    icon: "Accessibility",
    title: "Error prevention over error messages",
    desc: "Validating before submit and giving contextual, friendly feedback stops silent failures before they frustrate anyone.",
  },
  {
    icon: "Layers",
    title: "Preview as documentation",
    desc: "A live ID card makes abstract form data tangible — users see exactly what the system captured from them.",
  },
];
---

<BaseLayout
  title={`Student Registration Portal | Project by Misba Mushtaq`}
  description="An interactive student intake and registration system with real-time field validation, semantic input grouping and a live digital ID preview."
  path="/projects/registration/"
>
  <div id="top"></div>
  <Header compact />

  <main id="main-content" class="max-w-6xl mx-auto px-4 sm:px-6 pt-8 sm:pt-12 space-y-14 sm:space-y-20">
    <!-- Breadcrumb -->
    <Reveal variant="down">
      <div class="card rounded-2xl px-4 py-3 flex flex-wrap items-center justify-between gap-3">
        <a
          href="/#work"
          class="inline-flex items-center gap-2 text-sm font-semibold soft hover:text-brand transition-colors"
        >
          <ArrowLeft class="w-4 h-4" />
          Back to projects
        </a>
        <span class="chip chip-brand">Project 01 · Interactive web application</span>
      </div>
    </Reveal>

    <!-- Hero -->
    <section class="space-y-8">
      <Reveal variant="up" class="space-y-5 max-w-3xl">
        <span class="eyebrow">
          <GraduationCap class="w-3.5 h-3.5" />
          Academic case study
        </span>
        <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight leading-[1.05]">
          Student Registration
          <span class="text-gradient">Portal.</span>
        </h1>
        <p class="text-base sm:text-lg soft leading-relaxed">
          A student intake interface built to explore semantic form structures,
          real-time client validation, accessible fieldsets and a preview card that
          stays in sync with every keystroke.
        </p>
      </Reveal>

      <Reveal variant="up" delay={120}>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
          {
            facts.map((fact) => (
              <div class="card rounded-2xl p-5 space-y-1">
                <p class="text-[10px] font-bold uppercase tracking-[0.16em] muted">
                  {fact.label}
                </p>
                <p class="text-sm font-semibold">{fact.value}</p>
              </div>
            ))
          }
        </div>
      </Reveal>
    </section>

    <!-- Workspace -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      <!-- Form -->
      <Reveal variant="left" class="lg:col-span-7">
        <div class="card rounded-3xl p-6 sm:p-8 space-y-7">
          <div class="pb-4 border-b">
            <h2 class="font-display text-xl font-bold">Student enrolment form</h2>
            <p class="text-xs muted mt-1">
              Fill in the details — the digital ID card beside it updates as you type.
            </p>
          </div>

          <form id="student-reg-form" class="space-y-7" novalidate>
            <!-- Personal -->
            <fieldset class="space-y-4">
              <legend class="form-step">
                <User class="w-3.5 h-3.5" />
                1. Personal information
              </legend>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="field-label" for="first-name">First name *</label>
                  <input
                    class="field"
                    id="first-name"
                    name="firstName"
                    type="text"
                    required
                    autocomplete="given-name"
                    placeholder="e.g. Ayesha"
                  />
                </div>
                <div>
                  <label class="field-label" for="last-name">Last name *</label>
                  <input
                    class="field"
                    id="last-name"
                    name="lastName"
                    type="text"
                    required
                    autocomplete="family-name"
                    placeholder="e.g. Khan"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="field-label" for="dob">Date of birth *</label>
                  <input class="field" id="dob" name="dob" type="date" required />
                </div>
                <div>
                  <span class="field-label">Gender *</span>
                  <div class="grid grid-cols-3 gap-2">
                    {
                      ["Female", "Male", "Other"].map((option, i) => (
                        <label class="radio-tile">
                          <input
                            type="radio"
                            name="gender"
                            value={option}
                            checked={i === 0}
                          />
                          <span>{option}</span>
                        </label>
                      ))
                    }
                  </div>
                </div>
              </div>
            </fieldset>

            <!-- Academic -->
            <fieldset class="space-y-4 pt-5 border-t">
              <legend class="form-step">
                <BookOpen class="w-3.5 h-3.5" />
                2. Academic programme
              </legend>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="field-label" for="course">Diploma discipline *</label>
                  <select class="field" id="course" name="course" required>
                    <option value="Information Technology">Information Technology</option>
                    <option value="Computer Engineering">Computer Engineering</option>
                    <option value="Electronics & Communication">
                      Electronics & Communication
                    </option>
                    <option value="Civil Engineering">Civil Engineering</option>
                    <option value="Mechanical Engineering">Mechanical Engineering</option>
                  </select>
                </div>
                <div>
                  <label class="field-label" for="semester">Admission semester *</label>
                  <select class="field" id="semester" name="semester" required>
                    <option value="1st Semester">1st Semester (fresh intake)</option>
                    <option value="3rd Semester (Lateral)">3rd Semester (lateral)</option>
                    <option value="5th Semester" selected>5th Semester (senior)</option>
                  </select>
                </div>
              </div>
            </fieldset>

            <!-- Contact -->
            <fieldset class="space-y-4 pt-5 border-t">
              <legend class="form-step">
                <Mail class="w-3.5 h-3.5" />
                3. Contact & address
              </legend>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="field-label" for="reg-email">Email address *</label>
                  <input
                    class="field"
                    id="reg-email"
                    name="email"
                    type="email"
                    required
                    autocomplete="email"
                    placeholder="student@example.com"
                  />
                </div>
                <div>
                  <label class="field-label" for="reg-phone">Phone number *</label>
                  <input
                    class="field"
                    id="reg-phone"
                    name="phone"
                    type="tel"
                    required
                    pattern="[0-9 +()-]{7,18}"
                    autocomplete="tel"
                    placeholder="+91 98765 43210"
                  />
                </div>
              </div>

              <div>
                <label class="field-label" for="reg-address">Residential address *</label>
                <input
                  class="field"
                  id="reg-address"
                  name="address"
                  type="text"
                  required
                  autocomplete="street-address"
                  placeholder="House no, ward, street area"
                />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="field-label" for="reg-city">City / town *</label>
                  <input
                    class="field"
                    id="reg-city"
                    name="city"
                    type="text"
                    required
                    placeholder="e.g. Srinagar"
                  />
                </div>
                <div>
                  <label class="field-label" for="reg-state">State / UT *</label>
                  <select class="field" id="reg-state" name="state" required>
                    <option value="Jammu & Kashmir" selected>Jammu & Kashmir</option>
                    <option value="Delhi">Delhi NCR</option>
                    <option value="Punjab">Punjab</option>
                    <option value="Himachal Pradesh">Himachal Pradesh</option>
                    <option value="Other">Other region</option>
                  </select>
                </div>
              </div>
            </fieldset>

            <div class="flex flex-wrap items-center gap-3 pt-5 border-t">
              <button type="submit" class="btn btn-primary">
                <CircleCheck class="w-4 h-4" />
                Submit registration
              </button>
              <button type="reset" class="btn btn-ghost">
                <RotateCcw class="w-4 h-4" />
                Clear form
              </button>
            </div>

            <div
              id="form-notification"
              class="hidden"
              role="status"
              aria-live="polite"
            >
            </div>
          </form>
        </div>
      </Reveal>

      <!-- Live preview -->
      <Reveal variant="right" delay={100} class="lg:col-span-5 lg:sticky lg:top-28">
        <div class="card rounded-3xl p-6 space-y-4">
          <div class="flex items-center justify-between gap-3">
            <span class="eyebrow">
              <Sparkles class="w-3.5 h-3.5" />
              Live ID preview
            </span>
            <span
              id="preview-badge"
              class="chip text-amber-600 dark:text-amber-400 bg-amber-500/10"
            >
              Draft mode
            </span>
          </div>

          <div
            class="relative rounded-2xl p-6 text-white overflow-hidden border border-white/10 shadow-2xl"
            style="background:linear-gradient(140deg,#312e81,#4c1d95 45%,#0b1020)"
          >
            <div class="absolute -right-8 -bottom-8 opacity-10 pointer-events-none">
              <GraduationCap class="w-48 h-48" />
            </div>

            <div class="relative flex items-center justify-between pb-4 border-b border-white/15">
              <div class="flex items-center gap-2.5">
                <span class="w-8 h-8 rounded-lg grid place-items-center bg-white/15 font-bold text-xs">
                  KGP
                </span>
                <span>
                  <span class="block text-[11px] font-bold uppercase tracking-wider">
                    Polytechnic Institute
                  </span>
                  <span class="block text-[10px] text-white/60">Srinagar, Kashmir</span>
                </span>
              </div>
              <span class="text-[10px] px-2 py-0.5 rounded-full bg-white/15 font-mono">
                2026-REG
              </span>
            </div>

            <div class="relative pt-5 space-y-4">
              <div class="flex items-start gap-4">
                <span
                  class="w-16 h-16 rounded-xl grid place-items-center bg-white/10 border border-white/20 font-bold text-xl shrink-0"
                  id="card-avatar-initials">AK</span
                >
                <div class="space-y-0.5 min-w-0">
                  <p class="text-[10px] uppercase tracking-[0.14em] text-white/60 font-semibold">
                    Candidate name
                  </p>
                  <p id="card-name" class="font-display font-extrabold text-lg truncate">
                    Ayesha Khan
                  </p>
                  <p id="card-course" class="text-xs text-white/75">
                    Information Technology
                  </p>
                </div>
              </div>

              <div class="grid grid-cols-2 gap-3 pt-3 border-t border-white/10 text-xs">
                <div>
                  <span class="block text-[10px] text-white/55">Semester</span>
                  <span id="card-semester" class="font-semibold">5th Semester</span>
                </div>
                <div>
                  <span class="block text-[10px] text-white/55">Location</span>
                  <span id="card-city" class="font-semibold">Srinagar, Jammu &amp; Kashmir</span>
                </div>
                <div class="col-span-2 min-w-0">
                  <span class="block text-[10px] text-white/55">Contact email</span>
                  <span id="card-email" class="font-mono text-[11px] text-white/85 truncate block">
                    student@example.com
                  </span>
                </div>
              </div>
            </div>

            <div class="relative mt-5 pt-3 border-t border-white/10 flex items-center justify-between text-[10px] text-white/70">
              <span class="inline-flex items-center gap-1">
                <ShieldCheck class="w-3.5 h-3.5 text-emerald-400" />
                Verified registration token
              </span>
              <span class="font-mono" id="card-id-code">ID: #9482-IT</span>
            </div>
          </div>

          <p class="text-[11px] muted text-center leading-relaxed">
            The card is bound to the form through a single DOM update function —
            no framework, no re-render cycle.
          </p>
        </div>
      </Reveal>
    </section>

    <!-- Takeaways carousel -->
    <section class="space-y-10">
      <SectionHeading
        eyebrow="Technical takeaways"
        eyebrowIcon="Sparkles"
        title="What building this"
        accent="actually taught me."
        note="Four lessons that changed how I approach forms."
      />

      <Reveal variant="up">
        <Carousel label="Project takeaways" variant="trio" autoplay={5500} loop counter={false}>
          {
            takeaways.map((item, i) => (
              <article class="carousel__slide">
                <div class="card card-lift spotlight rounded-3xl p-6 h-full space-y-4">
                  <div class="flex items-center justify-between">
                    <span class="w-11 h-11 rounded-2xl grid place-items-center tint-brand">
                      <Icon name={item.icon} class="w-5 h-5" />
                    </span>
                    <span class="font-mono text-xs muted">
                      {String(i + 1).padStart(2, "0")}
                    </span>
                  </div>
                  <h3 class="font-display font-bold text-lg leading-tight">
                    {item.title}
                  </h3>
                  <p class="text-sm muted leading-relaxed">{item.desc}</p>
                </div>
              </article>
            ))
          }
        </Carousel>
      </Reveal>
    </section>

    <!-- Next -->
    <Reveal variant="up">
      <div class="card rounded-3xl p-8 sm:p-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <div class="space-y-1.5">
          <p class="eyebrow">Keep exploring</p>
          <h2 class="font-display text-2xl sm:text-3xl font-bold">
            See the rest of the portfolio
          </h2>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="/#work" class="btn btn-ghost">All projects</a>
          <a href="/resume/" class="btn btn-primary group">
            View resume
            <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-0.5" />
          </a>
        </div>
      </div>
    </Reveal>
  </main>

  <Footer />
</BaseLayout>

<style>
  .form-step {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand);
    margin-bottom: 0.25rem;
  }

  .radio-tile {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.5rem;
    border-radius: 0.75rem;
    border: 1px solid rgb(var(--line) / var(--line-alpha));
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.25s ease;
  }
  .radio-tile:hover {
    border-color: color-mix(in oklab, var(--brand) 45%, transparent);
  }
  .radio-tile:has(input:checked) {
    background: color-mix(in oklab, var(--brand) 12%, transparent);
    border-color: color-mix(in oklab, var(--brand) 55%, transparent);
    color: var(--brand);
  }
  .radio-tile input {
    accent-color: var(--brand);
  }

  #form-notification:not(.hidden) {
    display: block;
    padding: 1rem 1.15rem;
    border-radius: 1rem;
    font-size: 0.8125rem;
    line-height: 1.6;
    background: color-mix(in oklab, #10b981 14%, transparent);
    border: 1px solid color-mix(in oklab, #10b981 35%, transparent);
  }
</style>

<script>
  function setupRegistrationApp() {
    const form = document.getElementById("student-reg-form") as HTMLFormElement | null;
    if (!form || form.hasAttribute("data-bound")) return;
    form.setAttribute("data-bound", "true");

    const el = (id: string) => document.getElementById(id);
    const notification = el("form-notification");
    const previewBadge = el("preview-badge");
    const cardName = el("card-name");
    const cardCourse = el("card-course");
    const cardSemester = el("card-semester");
    const cardCity = el("card-city");
    const cardEmail = el("card-email");
    const cardInitials = el("card-avatar-initials");
    const cardId = el("card-id-code");

    const draftBadge = "chip text-amber-600 dark:text-amber-400 bg-amber-500/10";
    const doneBadge = "chip text-emerald-600 dark:text-emerald-400 bg-emerald-500/10";

    function updatePreview() {
      const data = new FormData(form as HTMLFormElement);
      const first = String(data.get("firstName") || "").trim();
      const last = String(data.get("lastName") || "").trim();
      const fullName = first || last ? `${first} ${last}`.trim() : "Ayesha Khan";

      if (cardName) cardName.textContent = fullName;
      if (cardCourse)
        cardCourse.textContent = String(data.get("course") || "Information Technology");
      if (cardSemester)
        cardSemester.textContent = String(data.get("semester") || "5th Semester");
      if (cardCity)
        cardCity.textContent = `${String(data.get("city") || "Srinagar")}, ${String(
          data.get("state") || "Jammu & Kashmir"
        )}`;
      if (cardEmail)
        cardEmail.textContent = String(data.get("email") || "student@example.com");
      if (cardInitials)
        cardInitials.textContent = (
          (first ? first[0] : "A") + (last ? last[0] : "K")
        ).toUpperCase();
    }

    form.addEventListener("input", updatePreview);
    form.addEventListener("change", updatePreview);

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const data = new FormData(form);
      const name = String(data.get("firstName") || "Student");
      const course = String(data.get("course") || "");
      const randomId = Math.floor(1000 + Math.random() * 9000);

      if (cardId) cardId.textContent = `ID: #${randomId}-IT`;
      if (previewBadge) {
        previewBadge.textContent = "Verified & enrolled";
        previewBadge.className = doneBadge;
      }
      if (notification) {
        notification.classList.remove("hidden");
        notification.replaceChildren();
        const lead = document.createElement("strong");
        lead.textContent = "Registration successful. ";
        notification.append(
          lead,
          document.createTextNode(
            `Welcome, ${name}. Your enrolment in ${course} has been logged in the demo system with ID #${randomId}-IT.`
          )
        );
        notification.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }
    });

    form.addEventListener("reset", () => {
      window.setTimeout(() => {
        updatePreview();
        if (notification) {
          notification.classList.add("hidden");
          notification.replaceChildren();
        }
        if (previewBadge) {
          previewBadge.textContent = "Draft mode";
          previewBadge.className = draftBadge;
        }
      }, 40);
    });

    updatePreview();
  }

  document.addEventListener("astro:page-load", setupRegistrationApp);
  if (document.readyState !== "loading") setupRegistrationApp();
</script>
