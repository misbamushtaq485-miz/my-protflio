---
import { Image } from "astro:assets";
import {
  ArrowLeft,
  Briefcase,
  CircleCheck,
  Code,
  Download,
  ExternalLink,
  FileCheck,
  GraduationCap,
  Languages,
  Layers,
  Mail,
  MapPin,
  Printer,
  Sparkles,
} from "@lucide/astro";

import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Reveal from "../components/Reveal.astro";
import LinkedInIcon from "../components/LinkedInIcon.astro";
import profileImage from "../../profile1.png";
import { profile } from "../data/portfolio";

const technicalSkills = [
  {
    group: "Front-End",
    items: [
      "HTML5 (semantic & accessible)",
      "CSS3 & modern layout systems",
      "Tailwind CSS v4",
      "JavaScript (ES6+)",
      "Astro framework",
    ],
  },
  {
    group: "Core Foundations",
    items: [
      "Data structures basics",
      "Computer networks",
      "Database management (DBMS)",
      "OOP fundamentals",
    ],
  },
  {
    group: "Tools & Practices",
    items: [
      "Git & GitHub",
      "Vite · PNPM",
      "Responsive web design",
      "View Transitions API",
      "Accessibility testing",
    ],
  },
];

const languages = [
  { name: "English", level: "Professional working proficiency", meter: 85 },
  { name: "Urdu", level: "Native / bilingual proficiency", meter: 100 },
  { name: "Kashmiri", level: "Native proficiency", meter: 100 },
];

const experience = [
  {
    title: "Software Development Intern",
    meta: "Hands-on practice & guided labs",
    period: "2024 — present",
    points: [
      "Designed and coded responsive, accessible interfaces following modern web standards.",
      "Engineered client-side form validation with native DOM APIs and semantic HTML5 attributes.",
      "Applied Git and GitHub workflows across repositories and collaborative reviews.",
      "Explored static-site optimisation and component-driven architecture with Astro and Tailwind.",
    ],
  },
];

const keyProjects = [
  {
    title: "Student Registration System",
    stack: "HTML5 · Tailwind CSS · JavaScript DOM · Form validation",
    href: "/projects/registration/",
    desc: "Interactive web application collecting and validating student admission data — pattern checks, accessible fieldsets, live preview card and reset logic.",
  },
  {
    title: "Personal Portfolio & Resume Platform",
    stack: "Astro 7 · Tailwind CSS v4 · TypeScript · View Transitions",
    href: "/",
    desc: "Static-first portfolio with a token-driven design system, theme persistence, scroll-linked motion, custom carousels and a print stylesheet.",
  },
];

const competencies = [
  "Fast learner",
  "Attention to detail",
  "Problem solving",
  "Collaboration",
  "Web performance",
  "Accessibility",
];
---

<BaseLayout
  title={`Resume | ${profile.name} — IT Student & Frontend Developer`}
  description={`Curriculum vitae of ${profile.name}, an Information Technology student and frontend developer based in Srinagar, Kashmir.`}
  path="/resume/"
>
  <div id="top"></div>
  <Header compact />

  <main id="main-content" class="max-w-5xl mx-auto px-4 sm:px-6 pt-8 sm:pt-12 space-y-6">
    <!-- Action bar -->
    <Reveal variant="down">
      <div class="card rounded-2xl px-4 py-3 flex flex-wrap items-center justify-between gap-3 print:hidden">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-sm font-semibold soft hover:text-brand transition-colors"
        >
          <ArrowLeft class="w-4 h-4" />
          Back to portfolio
        </a>

        <div class="flex items-center gap-2">
          <button type="button" id="print-resume-btn" class="btn btn-ghost btn-sm">
            <Printer class="w-3.5 h-3.5" />
            Print / Save as PDF
          </button>
          <a href={`mailto:${profile.email}`} class="btn btn-primary btn-sm">
            <Mail class="w-3.5 h-3.5" />
            Contact me
          </a>
        </div>
      </div>
    </Reveal>

    <!-- Resume sheet -->
    <Reveal variant="up">
      <article class="card rounded-[1.75rem] p-6 sm:p-10 lg:p-12 space-y-10 print:p-0">
        <!-- Masthead -->
        <header class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 pb-8 border-b">
          <div class="space-y-2.5">
            <span class="eyebrow print:hidden">
              <Sparkles class="w-3.5 h-3.5" />
              Curriculum Vitae
            </span>
            <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight">
              {profile.name}
            </h1>
            <p class="text-base sm:text-lg font-semibold text-brand">
              {profile.role}
            </p>
            <div class="flex flex-wrap items-center gap-x-5 gap-y-1.5 pt-1 text-xs muted">
              <span class="inline-flex items-center gap-1.5">
                <MapPin class="w-3.5 h-3.5" />
                {profile.location}
              </span>
              <a
                href={`mailto:${profile.email}`}
                class="inline-flex items-center gap-1.5 hover:text-brand transition-colors"
              >
                <Mail class="w-3.5 h-3.5" />
                {profile.email}
              </a>
              <a
                href={profile.linkedin}
                target="_blank"
                rel="noreferrer"
                class="inline-flex items-center gap-1.5 hover:text-brand transition-colors"
              >
                <LinkedInIcon class="w-3.5 h-3.5" />
                {profile.linkedinHandle}
              </a>
            </div>
          </div>

          <div class="shrink-0 print:hidden">
            <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl overflow-hidden card p-1">
              <Image
                src={profileImage}
                alt={profile.name}
                width={240}
                format="webp"
                quality={82}
                class="w-full h-full object-cover rounded-xl"
                transition:name="profile-portrait"
              />
            </div>
          </div>
        </header>

        <!-- Body grid -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-9 md:gap-11">
          <!-- Main column -->
          <div class="md:col-span-8 space-y-9">
            <section class="space-y-3">
              <h2 class="resume-h2">
                <FileCheck class="w-4 h-4" />
                Profile summary
              </h2>
              <p class="text-sm soft leading-relaxed">
                Motivated and detail-oriented 5th-semester Information Technology
                diploma student at {profile.school}. Strong foundation in web
                development, accessible markup, responsive CSS and modern JavaScript.
                Passionate about learning by doing, crafting user-friendly interfaces
                and solving real problems through clear, maintainable code.
              </p>
            </section>

            <section class="space-y-4">
              <h2 class="resume-h2">
                <GraduationCap class="w-4 h-4" />
                Education
              </h2>
              <div class="resume-block space-y-2">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <h3 class="font-bold">Diploma in Information Technology</h3>
                  <span class="chip chip-brand">Current · {profile.semester}</span>
                </div>
                <p class="text-xs font-semibold muted">{profile.school}</p>
                <p class="text-xs muted leading-relaxed">
                  Core coursework: data structures, computer networks, database
                  management systems, operating systems, software engineering and web
                  development.
                </p>
              </div>
            </section>

            <section class="space-y-4">
              <h2 class="resume-h2">
                <Briefcase class="w-4 h-4" />
                Practical experience
              </h2>
              {
                experience.map((role) => (
                  <div class="resume-block space-y-3">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                      <h3 class="font-bold">{role.title}</h3>
                      <span class="text-xs muted font-medium">{role.period}</span>
                    </div>
                    <p class="text-xs font-semibold muted">{role.meta}</p>
                    <ul class="space-y-2">
                      {role.points.map((point) => (
                        <li class="flex items-start gap-2 text-xs soft leading-relaxed">
                          <CircleCheck class="w-3.5 h-3.5 mt-0.5 shrink-0 text-brand" />
                          <span>{point}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))
              }
            </section>

            <section class="space-y-4">
              <h2 class="resume-h2">
                <Layers class="w-4 h-4" />
                Key projects
              </h2>
              <div class="space-y-3">
                {
                  keyProjects.map((project) => (
                    <div class="resume-block space-y-1.5">
                      <div class="flex items-center justify-between gap-3">
                        <h3 class="font-bold text-sm">{project.title}</h3>
                        <a
                          href={project.href}
                          class="text-xs font-semibold text-brand inline-flex items-center gap-1 hover:underline print:hidden"
                        >
                          View
                          <ExternalLink class="w-3 h-3" />
                        </a>
                      </div>
                      <p class="text-[11px] font-semibold muted">{project.stack}</p>
                      <p class="text-xs muted leading-relaxed">{project.desc}</p>
                    </div>
                  ))
                }
              </div>
            </section>
          </div>

          <!-- Sidebar -->
          <aside class="md:col-span-4 space-y-8">
            <section class="space-y-4">
              <h2 class="resume-h2">
                <Code class="w-4 h-4" />
                Technical skills
              </h2>
              {
                technicalSkills.map((group) => (
                  <div class="resume-block space-y-2">
                    <h3 class="text-[11px] font-bold uppercase tracking-[0.12em]">
                      {group.group}
                    </h3>
                    <ul class="space-y-1.5">
                      {group.items.map((item) => (
                        <li class="flex items-start gap-1.5 text-xs muted">
                          <CircleCheck class="w-3 h-3 mt-0.5 shrink-0 text-brand" />
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))
              }
            </section>

            <section class="space-y-4">
              <h2 class="resume-h2">
                <Languages class="w-4 h-4" />
                Languages
              </h2>
              <div class="resume-block space-y-3">
                {
                  languages.map((lang) => (
                    <div class="space-y-1.5">
                      <div class="flex items-center justify-between">
                        <p class="text-xs font-bold">{lang.name}</p>
                      </div>
                      <p class="text-[11px] muted">{lang.level}</p>
                      <div class="meter print:hidden" data-meter={String(lang.meter)}>
                        <span></span>
                      </div>
                    </div>
                  ))
                }
              </div>
            </section>

            <section class="space-y-4">
              <h2 class="resume-h2">
                <Sparkles class="w-4 h-4" />
                Core competencies
              </h2>
              <div class="flex flex-wrap gap-1.5">
                {competencies.map((item) => <span class="chip">{item}</span>)}
              </div>
            </section>

            <section class="space-y-3 print:hidden">
              <h2 class="resume-h2">
                <Download class="w-4 h-4" />
                Take it with you
              </h2>
              <p class="text-xs muted leading-relaxed">
                This page is print-optimised — use "Print / Save as PDF" for a clean,
                single-column document with no background effects.
              </p>
            </section>
          </aside>
        </div>
      </article>
    </Reveal>
  </main>

  <Footer />
</BaseLayout>

<style>
  .resume-h2 {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand);
  }

  .resume-block {
    padding: 1rem 1.15rem;
    border-radius: 1rem;
    border: 1px solid rgb(var(--line) / var(--line-alpha));
    background: rgb(var(--line) / 0.18);
  }

  @media print {
    .resume-block {
      background: #fff;
      border-color: #d4d4d8;
      padding: 0.5rem 0;
      border-left: 0;
      border-right: 0;
      border-top: 0;
      border-radius: 0;
    }
    .resume-h2 {
      color: #000;
    }
  }
</style>

<script>
  function setupResume() {
    const btn = document.getElementById("print-resume-btn");
    if (!btn || btn.hasAttribute("data-bound")) return;
    btn.setAttribute("data-bound", "true");
    btn.addEventListener("click", () => window.print());
  }
  document.addEventListener("astro:page-load", setupResume);
  if (document.readyState !== "loading") setupResume();
</script>
