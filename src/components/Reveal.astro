---
/**
 * Scroll-reveal wrapper. Adds the shared `data-reveal` hooks picked up by
 * src/scripts/enhance.ts and degrades to visible without JS-driven motion
 * for reduced-motion users.
 */
interface Props {
  variant?: "up" | "down" | "left" | "right" | "scale" | "blur";
  delay?: number;
  as?: "div" | "section" | "li" | "article" | "header" | "span";
  class?: string;
}

const {
  variant = "up",
  delay = 0,
  as: Tag = "div",
  class: className = "",
} = Astro.props;
---

<Tag
  class={className}
  data-reveal={variant}
  data-reveal-delay={delay ? String(delay) : undefined}
  style={delay ? `--reveal-delay:${delay}ms` : undefined}
>
  <slot />
</Tag>
