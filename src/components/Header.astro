---
import { Menu, X, ArrowUpRight, Send, House, FileText } from "@lucide/astro";
import ThemeToggle from "./ThemeToggle.astro";
import Icon from "./Icon.astro";
import { navItems, profile } from "../data/portfolio";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const prefix = compact ? "/" : "";
---

<header class="sticky top-3 sm:top-5 z-50 w-full px-3 sm:px-6 max-w-6xl mx-auto" data-site-header>
  <div
    class="card rounded-2xl sm:rounded-full px-3 sm:px-4 py-2 sm:py-2.5 flex items-center justify-between gap-3"
    data-header-shell
  >
    <!-- Brand -->
    <a
      href={compact ? "/" : "#top"}
      class="group flex items-center gap-2.5 shrink-0 rounded-full"
      aria-label={`${profile.name} — home`}
    >
      <span
        class="relative w-9 h-9 rounded-xl grid place-items-center text-white text-[11px] font-extrabold tracking-wider overflow-hidden"
        style="background:linear-gradient(135deg,var(--brand),var(--accent-2))"
        transition:name="site-brand-logo"
      >
        {profile.initials}
        <span class="absolute inset-0 bg-white/20 opacity-0 group-hover:opacity-100 transition-opacity"></span>
      </span>
      <span class="hidden sm:flex flex-col leading-tight">
        <span class="brand-name font-display font-bold text-sm tracking-tight transition-colors">
          {profile.name}
        </span>
        <span class="text-[10px] font-medium muted hidden sm:block">
          {profile.shortRole}
        </span>
      </span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden lg:flex items-center gap-0.5" aria-label="Sections">
      {
        compact && (
          <a href="/" class="nav-link" data-nav-link>
            Home
          </a>
        )
      }
      {
        navItems.map((item) => (
          <a
            href={`${prefix}${item.href}`}
            class="nav-link"
            data-nav-link
            aria-current="false"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/resume/"
        class="nav-link inline-flex items-center gap-1"
        aria-current={compact ? "true" : "false"}
      >
        Resume
        <ArrowUpRight class="w-3.5 h-3.5 opacity-60" />
      </a>
    </nav>

    <!-- Actions -->
    <div class="flex items-center gap-2 shrink-0">
      <span
        class="hidden xl:inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-[11px] font-semibold text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 border border-emerald-500/20"
      >
        <span class="relative flex w-1.5 h-1.5">
          <span class="absolute inset-0 rounded-full bg-emerald-400 animate-ring"></span>
          <span class="relative w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        </span>
        Open to work
      </span>

      <ThemeToggle />

      <a
        href={`${prefix}#contact`}
        class="btn btn-primary btn-sm hidden sm:inline-flex"
      >
        Say hello
        <Send class="w-3.5 h-3.5" />
      </a>

      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden grid place-items-center w-9 h-9 rounded-full border bg-[rgb(var(--line)/0.35)] transition-colors"
        aria-label="Toggle navigation"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span id="menu-icon-wrapper"><Menu class="w-4 h-4" /></span>
        <span id="close-icon-wrapper" class="hidden"><X class="w-4 h-4" /></span>
      </button>
    </div>
  </div>

  <!-- Mobile sheet -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden mt-2 card rounded-2xl p-3 overflow-hidden"
    role="dialog"
    aria-label="Navigation"
  >
    <nav class="flex flex-col gap-1">
      <a href="/" class="mobile-nav-link">
        <House class="w-4 h-4 muted" />
        <span>Home</span>
      </a>
      {
        navItems.map((item) => (
          <a href={`${prefix}${item.href}`} class="mobile-nav-link">
            <Icon name={item.icon} class="w-4 h-4 muted" />
            <span>{item.label}</span>
          </a>
        ))
      }
      <a href="/projects/registration/" class="mobile-nav-link mobile-nav-sub">
        <span>Student Registration Portal</span>
      </a>

      <div class="my-1.5 border-t"></div>

      <a
        href="/resume/"
        class="mobile-nav-link tint-brand font-semibold justify-between"
      >
        <span class="flex items-center gap-3">
          <FileText class="w-4 h-4" />
          Resume / CV
        </span>
        <ArrowUpRight class="w-4 h-4 opacity-60" />
      </a>

      <a href={`mailto:${profile.email}`} class="btn btn-primary mt-2 w-full">
        Say hello
        <Send class="w-4 h-4" />
      </a>
    </nav>
  </div>
</header>

<style>
  [data-header-shell] {
    transition: padding 0.35s ease, box-shadow 0.35s ease, background-color 0.35s ease;
  }
  [data-site-header][data-scrolled="true"] [data-header-shell] {
    box-shadow: var(--shadow-float);
    background: rgb(var(--surface) / 0.9);
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.9rem;
    border-radius: 0.85rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-soft);
    transition: background-color 0.25s ease, color 0.25s ease;
  }
  .mobile-nav-link:hover {
    background: rgb(var(--line) / 0.35);
    color: var(--text);
  }
  .mobile-nav-sub {
    padding-left: 2.75rem;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .group:hover .brand-name {
    color: var(--brand);
  }
</style>

<script>
  function setupHeader() {
    const header = document.querySelector<HTMLElement>("[data-site-header]");
    const btn = document.getElementById("mobile-menu-btn");
    const menu = document.getElementById("mobile-menu");
    const menuIcon = document.getElementById("menu-icon-wrapper");
    const closeIcon = document.getElementById("close-icon-wrapper");

    if (header && !header.hasAttribute("data-scroll-bound")) {
      header.setAttribute("data-scroll-bound", "true");
      const onScroll = () => {
        header.dataset.scrolled = String(window.scrollY > 24);
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
    }

    if (!btn || !menu) return;
    if (btn.hasAttribute("data-header-bound")) return;
    btn.setAttribute("data-header-bound", "true");

    const setOpen = (open: boolean) => {
      menu.classList.toggle("hidden", !open);
      menuIcon?.classList.toggle("hidden", open);
      closeIcon?.classList.toggle("hidden", !open);
      btn.setAttribute("aria-expanded", String(open));
    };

    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      setOpen(menu.classList.contains("hidden"));
    });

    menu.querySelectorAll(".mobile-nav-link").forEach((link) =>
      link.addEventListener("click", () => setOpen(false))
    );

    document.addEventListener("click", (e) => {
      const t = e.target as Node | null;
      if (!t) return;
      if (!menu.contains(t) && !btn.contains(t)) setOpen(false);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      if (menu.classList.contains("hidden")) return;
      setOpen(false);
      btn.focus();
    });
  }

  document.addEventListener("astro:page-load", setupHeader);
  if (document.readyState !== "loading") setupHeader();
</script>
