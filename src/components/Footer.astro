---
import { ArrowUp, Mail, Sparkles, ArrowUpRight } from "@lucide/astro";
import LinkedInIcon from "./LinkedInIcon.astro";
import { profile, navItems } from "../data/portfolio";
---

<footer class="relative mt-24 sm:mt-32 overflow-hidden border-t">
  <div class="absolute inset-x-0 -top-px h-px" style="background:linear-gradient(90deg,transparent,var(--brand),var(--accent),transparent)"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-14 sm:py-20">
    <!-- Big closing statement -->
    <div class="pb-12 sm:pb-16 border-b" data-reveal="up">
      <p class="eyebrow mb-4">
        <Sparkles class="w-3.5 h-3.5" />
        Let's build something
      </p>
      <a
        href={`mailto:${profile.email}`}
        class="group inline-flex flex-wrap items-baseline gap-x-4 gap-y-2 font-display text-3xl sm:text-5xl lg:text-6xl font-extrabold leading-[1.05] tracking-tight"
      >
        <span>Say hello</span>
        <span class="text-gradient">{profile.email}</span>
        <ArrowUpRight
          class="w-7 h-7 sm:w-10 sm:h-10 shrink-0 self-center transition-transform duration-300 group-hover:translate-x-1.5 group-hover:-translate-y-1.5"
        />
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 py-12 border-b">
      <!-- Identity -->
      <div class="md:col-span-5 space-y-4">
        <div class="flex items-center gap-3">
          <span
            class="w-9 h-9 rounded-xl grid place-items-center text-white text-[11px] font-extrabold"
            style="background:linear-gradient(135deg,var(--brand),var(--accent-2))"
          >
            {profile.initials}
          </span>
          <span class="font-display font-bold text-lg">{profile.name}</span>
        </div>
        <p class="text-sm soft leading-relaxed max-w-sm">
          Information Technology student at {profile.schoolShort}, turning coursework
          concepts into resilient, responsive and accessible interfaces.
        </p>
        <span
          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 border border-emerald-500/20"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          Open to internships & frontend roles
        </span>
      </div>

      <!-- Navigation -->
      <nav class="md:col-span-3 space-y-3" aria-label="Footer navigation">
        <h4 class="text-[11px] font-bold uppercase tracking-[0.16em] muted">
          Navigate
        </h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/" class="footer-link">Home</a>
          </li>
          {
            navItems.map((item) => (
              <li>
                <a href={`/${item.href}`} class="footer-link">
                  {item.label}
                </a>
              </li>
            ))
          }
          <li><a href="/resume/" class="footer-link">Resume</a></li>
        </ul>
      </nav>

      <!-- Elsewhere -->
      <div class="md:col-span-4 space-y-3">
        <h4 class="text-[11px] font-bold uppercase tracking-[0.16em] muted">
          Elsewhere
        </h4>
        <div class="flex flex-col gap-2.5 text-sm">
          <a href={`mailto:${profile.email}`} class="footer-link inline-flex items-center gap-2">
            <Mail class="w-4 h-4 muted" />
            {profile.email}
          </a>
          <a
            href={profile.linkedin}
            target="_blank"
            rel="noreferrer"
            class="footer-link inline-flex items-center gap-2"
          >
            <LinkedInIcon class="w-4 h-4 muted" />
            {profile.linkedinHandle}
          </a>
          <a href="/projects/registration/" class="footer-link inline-flex items-center gap-2">
            <ArrowUpRight class="w-4 h-4 muted" />
            Student Registration Portal
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs muted">
      <p>
        Designed & built by {profile.name}
        <span class="mx-1.5">·</span>
        <span id="current-year">2026</span>
      </p>
      <div class="flex items-center gap-4">
        <span class="inline-flex items-center gap-1.5">
          <Sparkles class="w-3.5 h-3.5 text-brand" />
          Astro · Tailwind v4 · Lucide
        </span>
        <a href="#top" class="btn btn-ghost btn-sm" aria-label="Back to top">
          Top
          <ArrowUp class="w-3.5 h-3.5" />
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-link {
    color: var(--text-muted);
    transition: color 0.25s ease, transform 0.25s ease;
    display: inline-flex;
  }
  .footer-link:hover {
    color: var(--brand);
    transform: translateX(2px);
  }
</style>

<script>
  function setYear() {
    const el = document.getElementById("current-year");
    if (el) el.textContent = String(new Date().getFullYear());
  }
  document.addEventListener("astro:page-load", setYear);
  if (document.readyState !== "loading") setYear();
</script>
