---
import { Sun, Moon, Monitor } from "@lucide/astro";

const options = [
  { value: "light", label: "Light", Glyph: Sun },
  { value: "dark", label: "Dark", Glyph: Moon },
  { value: "system", label: "System", Glyph: Monitor },
];
---

<div
  class="theme-switcher"
  role="radiogroup"
  aria-label="Colour theme"
>
  <span class="theme-thumb" aria-hidden="true"></span>
  {
    options.map(({ value, label, Glyph }) => (
      <button
        type="button"
        class="theme-btn"
        data-theme-value={value}
        role="radio"
        aria-checked="false"
        aria-label={`${label} theme`}
        title={`${label} theme`}
      >
        <Glyph class="w-4 h-4" />
      </button>
    ))
  }
</div>

<style>
  .theme-switcher {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding: 0.2rem;
    border-radius: 999px;
    background: rgb(var(--line) / 0.35);
    border: 1px solid rgb(var(--line) / var(--line-alpha));
    backdrop-filter: blur(10px);
  }

  .theme-thumb {
    position: absolute;
    top: 0.2rem;
    bottom: 0.2rem;
    left: 0.2rem;
    width: calc((100% - 0.4rem) / 3);
    border-radius: 999px;
    background: rgb(var(--surface) / 0.95);
    box-shadow: 0 2px 10px -4px rgba(0, 0, 0, 0.35);
    transform: translateX(var(--thumb-x, 0%));
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .theme-btn {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 999px;
    color: var(--text-muted);
    transition: color 0.3s ease, transform 0.3s ease;
  }
  @media (min-width: 640px) {
    .theme-btn {
      width: 2rem;
      height: 2rem;
    }
  }
  .theme-btn:hover {
    color: var(--text);
  }
  .theme-btn[aria-checked="true"] {
    color: var(--brand);
  }
  .theme-btn[aria-checked="true"]:active {
    transform: scale(0.92);
  }
</style>

<script>
  function setupThemeToggle() {
    const found = document.querySelector<HTMLElement>(".theme-switcher");
    if (!found) return;
    const container: HTMLElement = found;

    const buttons = Array.from(
      container.querySelectorAll<HTMLButtonElement>(".theme-btn")
    );

    function paint(value: string) {
      buttons.forEach((btn, i) => {
        const active = btn.dataset.themeValue === value;
        btn.setAttribute("aria-checked", String(active));
        if (active) container.style.setProperty("--thumb-x", `${i * 100}%`);
      });
    }

    paint(localStorage.getItem("portfolio-theme") || "dark");

    if (container.hasAttribute("data-theme-bound")) return;
    container.setAttribute("data-theme-bound", "true");

    function setTheme(mode: string) {
      localStorage.setItem("portfolio-theme", mode);

      const apply = () => {
        const effective =
          mode === "system"
            ? window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light"
            : mode;
        document.documentElement.dataset.theme = effective;
        document.documentElement.classList.toggle("dark", effective === "dark");
        paint(mode);
      };

      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!document.startViewTransition || reduced) apply();
      else document.startViewTransition(apply);
    }

    buttons.forEach((btn) =>
      btn.addEventListener("click", () => {
        const value = btn.dataset.themeValue;
        if (value) setTheme(value);
      })
    );

    window
      .matchMedia("(prefers-color-scheme: dark)")
      .addEventListener("change", (e) => {
        if (localStorage.getItem("portfolio-theme") !== "system") return;
        const next = e.matches ? "dark" : "light";
        document.documentElement.dataset.theme = next;
        document.documentElement.classList.toggle("dark", next === "dark");
      });
  }

  document.addEventListener("astro:page-load", setupThemeToggle);
  if (document.readyState !== "loading") setupThemeToggle();
</script>
